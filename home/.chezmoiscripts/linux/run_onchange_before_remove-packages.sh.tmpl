#!/bin/bash
{{- if eq .osid "linux-ubuntu" }}
{{- $packages := list
     "aisleriot"
     "gnome-mahjongg"
     "gnome-mines"
     "gnome-sudoku"
     "thunderbird" }}
{{- $snaps := list }}
{{- $sudo := "sudo " }}
{{- if eq .chezmoi.username "root" }}
{{-   $sudo = "" }}
{{- end }}
set -uo pipefail

for pkg in {{ $packages | join " " }}; do
  {{ $sudo }}apt-get remove -y "$pkg" || echo "Warning: failed to remove $pkg" >&2
done
{{- if lookPath "snap" }}
{{-   range $snaps }}
( snap info {{ . }} 2>/dev/null | grep -q ^installed: ) && {{ $sudo }}snap remove {{ . }} || echo "Warning: failed to remove snap {{ . }}" >&2
{{-   end }}
{{- end }}
{{- end }}

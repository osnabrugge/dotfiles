#!/bin/bash
{{- if eq .osid "linux-debian" "linux-raspbian" "linux-ubuntu" }}
{{- $packages := list
     "bat"
     "build-essential"
     "curl"
     "eza"
     "fastfetch"
     "fd-find"
     "fzf"
     "git"
     "git-lfs"
     "jq"
     "lazygit"
     "openssh-server"
     "ripgrep"
     "shellcheck"
     "starship"
     "thefuck"
     "units"
     "yq"
     "zoxide"
     "zsh" }}
{{- $snaps := list }}
{{- $classicSnaps := list }}
{{- if eq .osid "linux-ubuntu" }}
{{-   $packages = mustAppend $packages "btop" }}
{{-   $snaps = mustAppend $snaps "bw" }}
{{- end }}
{{- if not .headless }}
{{-   $packages = mustAppend $packages "xclip" }}
{{-   $classicSnaps = mustAppend $classicSnaps "code" }}
{{- end }}
{{- if .personal }}
{{-   $packages = mustAppend $packages "musl-tools" }}
{{-   $classicSnaps = concat $classicSnaps (list "goreleaser" "snapcraft") }}
{{- end }}
{{- $sudo := "sudo " }}
{{- if eq .chezmoi.username "root" }}
{{-   $sudo = "" }}
{{- end }}
set -uo pipefail

{{ $sudo }}apt-get update || echo "Warning: apt-get update failed" >&2

for pkg in {{ $packages | join " " }}; do
  {{ $sudo }}apt-get install -y "$pkg" || echo "Warning: failed to install $pkg" >&2
done
{{- if lookPath "snap" }}
{{-   range $snaps }}
( snap info {{ . }} 2>/dev/null | grep -q ^installed: ) || {{ $sudo }}snap install {{ . }} || echo "Warning: failed to install snap {{ . }}" >&2
{{-   end }}
{{-   range $classicSnaps }}
( snap info {{ . }} 2>/dev/null | grep -q ^installed: ) || {{ $sudo }}snap install --classic {{ . }} || echo "Warning: failed to install snap {{ . }}" >&2
{{-   end }}
{{- end }}
{{- end }}
